{
 "version": 1,
 "description": "Cross-language golden vectors for T31 project-config normalization (wrangler.toml / wrangler.json / wrangler.jsonc -> normalized WorkerProjectConfig). Every entry materializes `files` into a project dir, applies `configFile`/`envName`, then expects either the normalized config or a typed error. cloudflare.config.ts vectors are NOT here — that mapping is CLI-local (see doc/platform/workers-runtime-project-config.md).",
 "vectors": [
  {
   "name": "toml full mapping",
   "files": {
    "wrangler.toml": "name = \"edge-api\"\nmain = \"src/worker.ts\"\ncompatibility_date = \"2025-01-15\"\ncompatibility_flags = [\"nodejs_compat\"]\naccount_id = \"cf-account-1\"\nworkers_dev = true\nroutes = [\"api.example.com/*\", \"www.example.com\"]\n\n[vars]\nLOG_LEVEL = \"info\"\nLIMIT = 42\nFLAG = true\n\n[[kv_namespaces]]\nbinding = \"CACHE\"\nid = \"ns-1\"\n\n[[r2_buckets]]\nbinding = \"BUCKET\"\nbucket_name = \"my-bucket\"\n\n[[services]]\nbinding = \"SVC\"\nservice = \"other-worker\"\nentrypoint = \"ApiEntrypoint\"\n\n[triggers]\ncrons = [\"*/15 * * * *\", \"0 9 * * mon-fri\"]\n\n[assets]\ndirectory = \"public\"\nbinding = \"ASSETS\"\nhtml_handling = \"auto-trailing-slash\"\nnot_found_handling = \"single-page-application\"\n"
   },
   "expect": {
    "ok": true,
    "source": "wrangler.toml",
    "config": {
     "schemaVersion": 1,
     "name": "edge-api",
     "main": "src/worker.ts",
     "compatibilityDate": "2025-01-15",
     "compatibilityFlags": [
      "nodejs_compat"
     ],
     "vars": {
      "LOG_LEVEL": "info",
      "LIMIT": 42,
      "FLAG": true
     },
     "bindings": [
      {
       "type": "kv",
       "name": "CACHE",
       "id": "ns-1"
      },
      {
       "type": "r2",
       "name": "BUCKET",
       "bucketName": "my-bucket"
      },
      {
       "type": "service",
       "name": "SVC",
       "service": "other-worker",
       "entrypoint": "ApiEntrypoint"
      }
     ],
     "crons": [
      "*/15 * * * *",
      "0 9 * * mon-fri"
     ],
     "routeHostnames": [
      "api.example.com",
      "www.example.com"
     ],
     "assets": {
      "directory": "public",
      "binding": "ASSETS",
      "htmlHandling": "auto-trailing-slash",
      "notFoundHandling": "single-page-application"
     }
    }
   }
  },
  {
   "name": "jsonc with comments and trailing commas",
   "files": {
    "wrangler.jsonc": "// project config\n{\n  \"name\": \"json-api\",\n  \"main\": \"dist/index.js\",\n  \"compatibility_date\": \"2025-03-01\",\n  \"vars\": {\n    \"MODE\": \"prod\", // trailing\n  },\n  \"kv_namespaces\": [\n    { \"binding\": \"KV\" },\n  ],\n}\n"
   },
   "expect": {
    "ok": true,
    "source": "wrangler.jsonc",
    "config": {
     "schemaVersion": 1,
     "name": "json-api",
     "main": "dist/index.js",
     "compatibilityDate": "2025-03-01",
     "vars": {
      "MODE": "prod"
     },
     "bindings": [
      {
       "type": "kv",
       "name": "KV"
      }
     ]
    }
   }
  },
  {
   "name": "env merge replaces non-inheritable keys",
   "files": {
    "wrangler.toml": "name = \"svc\"\nmain = \"src/index.ts\"\ncompatibility_date = \"2025-01-01\"\n\n[vars]\nA = \"base\"\nB = \"base\"\n\n[env.production]\ncompatibility_date = \"2025-06-01\"\n\n[env.production.vars]\nB = \"prod\"\nC = \"prod\"\n"
   },
   "envName": "production",
   "expect": {
    "ok": true,
    "source": "wrangler.toml",
    "config": {
     "schemaVersion": 1,
     "name": "svc",
     "main": "src/index.ts",
     "compatibilityDate": "2025-06-01",
     "vars": {
      "B": "prod",
      "C": "prod"
     }
    }
   }
  },
  {
   "name": "env name without matching env block",
   "files": {
    "wrangler.toml": "name = \"svc\"\nmain = \"src/index.ts\"\ncompatibility_date = \"2025-01-01\"\n"
   },
   "envName": "staging",
   "expect": {
    "ok": false,
    "code": "VRT_CONFIG_INVALID",
    "field": "env"
   }
  },
