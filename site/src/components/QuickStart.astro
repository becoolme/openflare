---
import { content } from '../data/content';
const { qs } = content;
---
<section id="start" style="border-bottom: 1px solid #E6E7EB">
<div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 9vw, 120px) clamp(16px, 4vw, 32px); display: flex; flex-direction: column; gap: 40px">
<div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 20px 48px">
<div style="flex: 1 1 520px; display: flex; flex-direction: column; gap: 14px">
<div style="font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 0.12em; color: #2450E6">06 · QUICK START</div>
<h2 style="margin: 0; font-weight: 600; font-size: clamp(34px, 4.4vw, 56px); line-height: 1.02; letter-spacing: -0.04em; color: #0F1A2E">Three steps to a first request.</h2>
</div>
<p style="flex: 1 1 380px; margin: 0; max-width: 460px; font-size: 17px; color: #334055">You need Docker and a workerd binary. OpenFlare never downloads workerd for you; it checks yours against the digest in <code style="font-family: 'JetBrains Mono', monospace; font-size: 15px">workerd.lock</code>.</p>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(330px, 1fr)); gap: 20px; counter-reset: s">
{qs.map((q) => (<Fragment>
<div style="display: flex; flex-direction: column; border: 1px solid #D5DAE3; border-radius: 14px; background: #FFFFFF; overflow: hidden">
<div style="display: flex; flex-direction: column; gap: 8px; padding: 22px 22px 18px">
<div style="display: flex; align-items: center; gap: 12px">
<svg aria-hidden="true" width="40" height="40" viewBox="0 0 40 40" fill="none"><circle cx="20" cy="20" r="18.5" stroke="#C9CFDA" stroke-width="1"></circle><circle cx="20" cy="20" r="18.5" stroke="#2450E6" stroke-width="1.25" stroke-dasharray="2 4" style="transform-origin: 20px 20px; transform-box: view-box; animation: of-spin 12s linear infinite"></circle><text x="20" y="24.5" fill="#2450E6" font-family="JetBrains Mono, monospace" font-size="12" text-anchor="middle">{q.n}</text></svg>
<h3 style="margin: 0; font-size: 19px; font-weight: 600; letter-spacing: -0.02em; color: #0F1A2E">{q.t}</h3>
</div>
<p style="margin: 0; font-size: 14.5px; color: #4B5568">{q.d}</p>
</div>
<pre style="margin: 0; margin-top: auto; padding: 16px 18px; overflow-x: auto; border-top: 1px solid #EDEFF3; background: #F6F8FC; font-family: 'JetBrains Mono', monospace; font-size: 12.5px; line-height: 1.75; color: #0F1A2E">{q.code}</pre>
</div>
</Fragment>))}
</div>
<div style="display: flex; flex-wrap: wrap; gap: 12px 28px; font-size: 15px">
<a href="https://github.com/becoolme/openflare/blob/main/deploy/standalone/README.md" style="display: inline-flex; align-items: center; gap: 8px; min-height: 44px; color: #2450E6"><span>Standalone guide: rollback, versions, backup</span><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg></a>
<a href="https://github.com/becoolme/openflare/tree/main/examples" style="display: inline-flex; align-items: center; gap: 8px; min-height: 44px; color: #2450E6"><span>Browse the examples</span><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg></a>
</div>
</div>
</section>
