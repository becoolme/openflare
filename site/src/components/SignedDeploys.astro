<section id="deploys" style="border-bottom: 1px solid #E6E7EB; background: #FFFFFF">
<div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 9vw, 120px) clamp(16px, 4vw, 32px); display: flex; flex-wrap: wrap; align-items: center; gap: 48px 64px">
