---
import { content } from '../data/content';
const { faq } = content;
---
<section id="faq" style="border-bottom: 1px solid #E6E7EB; background: #FFFFFF">
<div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 9vw, 120px) clamp(16px, 4vw, 32px); display: flex; flex-wrap: wrap; gap: 32px 64px">
<div style="flex: 1 1 320px; display: flex; flex-direction: column; gap: 14px">
<div style="font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 0.12em; color: #2450E6">07 · FAQ</div>
<h2 style="margin: 0; font-weight: 600; font-size: clamp(34px, 4.4vw, 56px); line-height: 1.02; letter-spacing: -0.04em; color: #0F1A2E">Questions.</h2>
<p style="margin: 0; font-size: 16px; color: #4B5568">Something missing? <a href="https://github.com/becoolme/openflare/issues" style="color: #2450E6; text-decoration: underline; text-underline-offset: 3px">Open an issue</a>.</p>
</div>
<div style="flex: 2 1 560px; min-width: 0; border-top: 1px solid #D5DAE3">
{faq.map((f) => (<Fragment>
<details style="border-bottom: 1px solid #D5DAE3">
<summary style="display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 64px; font-size: 17.5px; font-weight: 500; color: #0F1A2E"><span>{f.q}</span><svg class="of-plus" aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="#5B6678" stroke-width="1.3" stroke-linecap="round" style="flex: 0 0 auto; transition: transform .2s"><path d="M9 3v12M3 9h12"></path></svg></summary>
<p style="margin: 0; padding: 0 40px 22px 0; font-size: 15.5px; color: #4B5568">{f.a}</p>
</details>
</Fragment>))}
</div>
</div>
</section>
