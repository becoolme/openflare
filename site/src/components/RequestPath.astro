---
import { content } from '../data/content';
const { steps } = content;
---
<section id="how" style="border-bottom: 1px solid #E6E7EB; background: #FFFFFF">
<div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 9vw, 120px) clamp(16px, 4vw, 32px); display: flex; flex-direction: column; gap: 40px">
<div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 20px 48px">
<div style="flex: 1 1 520px; display: flex; flex-direction: column; gap: 14px">
<div style="font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 0.12em; color: #2450E6">01 · HOW IT WORKS</div>
<h2 style="margin: 0; font-weight: 600; font-size: clamp(34px, 4.4vw, 56px); line-height: 1.02; letter-spacing: -0.04em; color: #0F1A2E">Anatomy of a request.</h2>
</div>
<p style="flex: 1 1 380px; margin: 0; max-width: 460px; font-size: 17px; color: #334055">Seven steps between a client and your <code style="font-family: 'JetBrains Mono', monospace; font-size: 15px">fetch()</code> handler. Every hop is a small Rust service you can read, run and replace.</p>
</div>
<div style="overflow-x: auto; border: 1px solid #D5DAE3; border-radius: 16px; background-color: #FCFCFA; background-image: linear-gradient(#F1F2F5 1px, transparent 1px), linear-gradient(90deg, #F1F2F5 1px, transparent 1px); background-size: 20px 20px">
<svg role="img" aria-label="Request path: a client request enters the vrt-host ingress, which strips trust headers, routes by Host and wakes an idle tenant, then forwards over a unix socket to the tenant's workerd. Binding calls go through facade workers to vrt-provider and vrt-sql. Outbound calls pass the vrt-egress filter. A signed snapshot feeds the ingress." viewBox="0 0 1160 380" style="display: block; width: 100%; min-width: 960px; height: auto" fill="none" stroke-linecap="round" stroke-linejoin="round" font-family="JetBrains Mono, monospace">
<defs>
<marker id="of3-arr-a" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto"><path d="M0 0.5L7 4L0 7.5Z" fill="#2450E6"></path></marker>
<marker id="of3-arr-t" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto"><path d="M0 0.5L7 4L0 7.5Z" fill="#0E8A7A"></path></marker>
<marker id="of3-arr-g" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto"><path d="M0 0.5L7 4L0 7.5Z" fill="#6B7587"></path></marker>
</defs>
<text x="24" y="32" fill="#5B6678" font-size="10" letter-spacing="1.4" stroke="none">FIG. 02 — REQUEST PATH</text>
<text x="1136" y="32" fill="#5B6678" font-size="10" letter-spacing="1.4" text-anchor="end" stroke="none">SINGLE HOST · STANDALONE</text>

<!-- public net -->
<path d="M880 70H1130" stroke="#8C96A8" stroke-width="0.75" stroke-dasharray="6 4"></path>
<text x="1130" y="62" fill="#5B6678" font-size="9.5" letter-spacing="1" text-anchor="end" stroke="none">PUBLIC INTERNET</text>

<!-- edges -->
<path d="M150 170H226" stroke="#2450E6" stroke-width="1.25" marker-end="url(#of3-arr-a)"></path>
<path d="M470 170H546" stroke="#2450E6" stroke-width="1.25" marker-end="url(#of3-arr-a)"></path>
<path d="M800 170H876" stroke="#6B7587" stroke-width="1.25" marker-end="url(#of3-arr-g)"></path>
<path d="M995 116V76" stroke="#6B7587" stroke-width="1.25" marker-end="url(#of3-arr-g)"></path>
<path d="M610 224V286" stroke="#0E8A7A" stroke-width="1.25" marker-end="url(#of3-arr-t)"></path>
<path d="M740 224V286" stroke="#0E8A7A" stroke-width="1.25" marker-end="url(#of3-arr-t)"></path>
<path d="M350 290V230" stroke="#6B7587" stroke-width="1.25" stroke-dasharray="4 4" marker-end="url(#of3-arr-g)"></path>
<!-- packets -->
<circle r="3.5" fill="#2450E6" style="offset-path: path('M150 170H470'); animation: of-move 2.2s linear infinite"></circle>
<circle r="3.5" fill="#2450E6" style="offset-path: path('M470 170H546'); animation: of-move 2.2s linear infinite; animation-delay: 1.1s"></circle>
<circle r="3" fill="#0E8A7A" style="offset-path: path('M610 224V290'); animation: of-move 1.6s linear infinite"></circle>
<circle r="3" fill="#0E8A7A" style="offset-path: path('M740 224V290'); animation: of-move 1.6s linear infinite; animation-delay: .8s"></circle>
<circle r="3" fill="#6B7587" style="offset-path: path('M800 170H995V76'); animation: of-move 2.8s linear infinite"></circle>

<!-- client -->
<rect x="24" y="136" width="126" height="68" rx="8" fill="#FFFFFF" stroke="#0F1A2E" stroke-width="1"></rect>
<text x="40" y="164" fill="#0F1A2E" font-size="13" stroke="none">Client</text>
<text x="40" y="184" fill="#5B6678" font-size="10" stroke="none">HTTP · WS</text>
<!-- ingress -->
<rect x="228" y="116" width="242" height="114" rx="8" fill="#FFFFFF" stroke="#0F1A2E" stroke-width="1"></rect>
<text x="244" y="142" fill="#0F1A2E" font-size="13" stroke="none">vrt-host ingress</text>
<path d="M244 152H454" stroke="#E6E7EB" stroke-width="1"></path>
<text x="244" y="172" fill="#334055" font-size="10.5" stroke="none">strip trust headers</text>
<text x="244" y="192" fill="#334055" font-size="10.5" stroke="none">route by Host</text>
<text x="244" y="212" fill="#334055" font-size="10.5" stroke="none">wake if scaled to zero</text>
<!-- workerd -->
<rect x="548" y="116" width="252" height="108" rx="8" fill="#F4F7FE" stroke="#2450E6" stroke-width="1.25"></rect>
<text x="564" y="142" fill="#0F1A2E" font-size="13" stroke="none">workerd · tenant</text>
<path d="M564 152H784" stroke="#D6E0FA" stroke-width="1"></path>
<text x="564" y="172" fill="#334055" font-size="10.5" stroke="none">your fetch() handler</text>
<rect x="564" y="184" width="220" height="28" rx="5" fill="#FFFFFF" stroke="#9DB3F2" stroke-width="0.75" stroke-dasharray="3 3"></rect>
<text x="674" y="202" fill="#334055" font-size="10" text-anchor="middle" stroke="none">facade workers → bindings</text>
<!-- egress -->
<rect x="878" y="116" width="234" height="108" rx="8" fill="#FFFFFF" stroke="#6B7587" stroke-width="1" stroke-dasharray="5 4"></rect>
<text x="894" y="142" fill="#0F1A2E" font-size="13" stroke="none">vrt-egress</text>
<path d="M894 152H1096" stroke="#E6E7EB" stroke-width="1"></path>
<text x="894" y="172" fill="#334055" font-size="10.5" stroke="none">fetch() · connect()</text>
<text x="894" y="192" fill="#334055" font-size="10.5" stroke="none">check resolved address</text>
<text x="894" y="212" fill="#B4311F" font-size="10.5" stroke="none">✕ private · link-local · metadata</text>
<!-- storage -->
<rect x="548" y="290" width="124" height="64" rx="8" fill="#FFFFFF" stroke="#0E8A7A" stroke-width="1"></rect>
<text x="564" y="316" fill="#0F1A2E" font-size="12" stroke="none">vrt-provider</text>
<text x="564" y="336" fill="#5B6678" font-size="9.5" stroke="none">KV · R2 · Queues</text>
<rect x="680" y="290" width="120" height="64" rx="8" fill="#FFFFFF" stroke="#0E8A7A" stroke-width="1"></rect>
<text x="696" y="316" fill="#0F1A2E" font-size="12" stroke="none">vrt-sql</text>
<text x="696" y="336" fill="#5B6678" font-size="9.5" stroke="none">D1 · DO SQL</text>
<!-- snapshot -->
<rect x="228" y="290" width="242" height="64" rx="8" fill="#FFFFFF" stroke="#0F1A2E" stroke-width="1"></rect>
<text x="244" y="316" fill="#0F1A2E" font-size="12" stroke="none">signed snapshot</text>
<text x="244" y="336" fill="#5B6678" font-size="9.5" stroke="none">verify → apply · fail closed</text>

<!-- step badges -->
<g font-size="10" text-anchor="middle">
<circle cx="188" cy="150" r="10" fill="#FFFFFF" stroke="#2450E6" stroke-width="1"></circle><text x="188" y="153.5" fill="#2450E6" stroke="none">1</text>
<circle cx="458" cy="168" r="0" stroke="none"></circle>
<circle cx="230" cy="166" r="0" stroke="none"></circle>
<circle cx="440" cy="168" r="9" fill="#FFFFFF" stroke="#2450E6" stroke-width="1"></circle><text x="440" y="171.5" fill="#2450E6" stroke="none">2</text>
<circle cx="440" cy="188" r="9" fill="#FFFFFF" stroke="#2450E6" stroke-width="1"></circle><text x="440" y="191.5" fill="#2450E6" stroke="none">3</text>
<circle cx="440" cy="208" r="9" fill="#FFFFFF" stroke="#2450E6" stroke-width="1"></circle><text x="440" y="211.5" fill="#2450E6" stroke="none">4</text>
<circle cx="508" cy="150" r="10" fill="#FFFFFF" stroke="#2450E6" stroke-width="1"></circle><text x="508" y="153.5" fill="#2450E6" stroke="none">5</text>
<circle cx="675" cy="258" r="10" fill="#FFFFFF" stroke="#0E8A7A" stroke-width="1"></circle><text x="675" y="261.5" fill="#0B7466" stroke="none">6</text>
<circle cx="838" cy="150" r="10" fill="#FFFFFF" stroke="#6B7587" stroke-width="1"></circle><text x="838" y="153.5" fill="#4B5568" stroke="none">7</text>
</g>
<text x="508" y="194" fill="#5B6678" font-size="9" text-anchor="middle" stroke="none">unix</text>
<text x="508" y="206" fill="#5B6678" font-size="9" text-anchor="middle" stroke="none">socket</text>
<text x="362" y="264" fill="#5B6678" font-size="9.5" stroke="none">desired state</text>
</svg>
</div>
<ol style="margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 0; border-top: 1px solid #D5DAE3">
{steps.map((s) => (<Fragment>
<li style="display: flex; gap: 14px; padding: 18px 20px 18px 0; border-bottom: 1px solid #EDEFF3">
<span style="flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 50%; border: 1px solid #C9CFDA; font-family: 'JetBrains Mono', monospace; font-size: 11.5px; color: #334055">{s.n}</span>
<span style="display: flex; flex-direction: column; gap: 2px"><b style="font-weight: 600; font-size: 15.5px; color: #0F1A2E">{s.t}</b><span style="font-size: 14.5px; color: #4B5568">{s.d}</span></span>
</li>
</Fragment>))}
</ol>
</div>
</section>
