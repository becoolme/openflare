---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import RequestPath from '../components/RequestPath.astro';
import Topologies from '../components/Topologies.astro';
import SignedDeploys from '../components/SignedDeploys.astro';
import Compatibility from '../components/Compatibility.astro';
import DeveloperExperience from '../components/DeveloperExperience.astro';
import QuickStart from '../components/QuickStart.astro';
import Faq from '../components/Faq.astro';
import Closing from '../components/Closing.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="OpenFlare — Workers-style apps on your own hardware"
  description="OpenFlare is a self-hostable runtime for Workers-style applications, written in Rust around unmodified workerd: signed deploys, KV, R2, D1, Queues and Durable Objects, one isolated process per tenant."
>
  <Nav />
  <main>
    <Hero />
    <RequestPath />
    <Topologies />
    <SignedDeploys />
    <Compatibility />
    <DeveloperExperience />
    <QuickStart />
    <Faq />
    <Closing />
  </main>
  <Footer />
</Base>
