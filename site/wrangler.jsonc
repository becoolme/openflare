{
  // Static-assets-only Worker: no `main`, Cloudflare serves dist/ directly.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openflare-site",
  "compatibility_date": "2026-11-01",
  // Custom Domain: Cloudflare creates the DNS record and certificate.
  // The openflare.app zone must be on the deploying account.
  "routes": [{ "pattern": "openflare.app", "custom_domain": true }],
  // Keep the *.workers.dev URL too; set to false to serve only openflare.app.
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
