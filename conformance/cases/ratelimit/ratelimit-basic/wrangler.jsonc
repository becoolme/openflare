{
  "name": "conf-ratelimit-basic",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "routes": ["conf-ratelimit-basic.vrt.local/*"],
  "ratelimits": [
    {
      "name": "LIMITER",
