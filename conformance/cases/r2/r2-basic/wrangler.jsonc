// Conformance case: R2 transport surface — put/get/head/delete/list,
// range reads, conditional (onlyIf) writes and reads.
{
  "name": "conf-r2-basic",
  "main": "worker.js",
  "compatibility_date": "2024-09-25",
  "routes": ["conf-r2-basic.vrt.local/*"],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "conf-r2-basic" }],
}
