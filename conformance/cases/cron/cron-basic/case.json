{
  "schemaVersion": 1,
  "id": "cron-basic",
  "binding": "cron",
  "title": "Cron trigger delivers scheduled() with controller.cron/scheduledTime/type",
  "requiresWorkerd": true,
  "evidence": [
    "https://developers.cloudflare.com/workers/configuration/cron-triggers/ (scheduled event: cron string, scheduledTime, type \"scheduled\")",
    "examples/standalone-cron/main.js + comments (standalone CronRunner ticks every 30 s; fires via facade-cron \u2192 Fetcher.scheduled)"
  ],
  "readyTimeoutMs": 180000,
  "steps": [
    {
      "name": "scheduled() fires within one tick",
      "request": {
        "path": "/hits"
      },
      "expect": {
        "status": 200,
        "json": {
          "fired": true,
          "first": {
            "cron": "* * * * *",
            "type": "scheduled"
          }
        },
        "bodyMatches": "\"scheduled_ms\":[1-9]"
      },
      "retry": {
        "timeoutMs": 150000,
        "intervalMs": 5000
      }
    }
  ]
}
