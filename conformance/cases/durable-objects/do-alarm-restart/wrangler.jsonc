// Conformance case: DO alarm persistence across a runtime restart.
{
  "name": "conf-do-alarm-restart",
  "main": "worker.js",
  "compatibility_date": "2024-09-25",
  "routes": ["conf-do-alarm-restart.vrt.local/*"],
  "durable_objects": {
    "bindings": [{ "name": "ALARMS", "class_name": "AlarmChain" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AlarmChain"] }],
}
