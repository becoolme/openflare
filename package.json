{
  "name": "openflare",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "pg": "8.16.3",
    "pg-cloudflare": "1.4.0"
  },
  "scripts": {
    "facade:build": "node facade/tools/gen-manifest.mjs",
    "facade:check": "node facade/tools/gen-manifest.mjs --check",
    "test:facade": "node --test facade/test/*.test.mjs",
    "test:pin": "node --test scripts/test/*.test.mjs",
    "test:contract": "node contract/check-egress-deny-ranges.mjs && node contract/gen-facade-requests.mjs --check",
    "test:docs": "node docs/check-docs.mjs",
    "test:rust": "cargo test --workspace --offline",
    "test": "npm run facade:check && npm run test:facade && npm run test:pin && npm run test:contract && npm run test:docs && npm run test:conformance && npm run test:rust",
    "test:conformance": "node --test conformance/test/*.test.mjs"
  }
}
